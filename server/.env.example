# Copy to server/.env and fill in. server/.env is git-ignored — never commit real credentials.
# Used by both docker-compose (database container) and the Spring Boot app.

DB_URL=jdbc:postgresql://localhost:5433/code76
DB_USERNAME=code76
DB_PASSWORD=change-me-to-a-long-random-string

# Exact frontend origins allowed to call the API (comma-separated, no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Encrypts secrets saved in the admin (Razorpay key secret, webhook secret). 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it safe and don't change it later, or keys saved in the admin can't be read (just re-enter them).
SETTINGS_ENCRYPTION_KEY=

# Razorpay. Easiest: paste the keys in Admin → Store settings → Payments (those take priority).
# These are an optional fallback. Use TEST MODE keys while developing: Dashboard → Test Mode → API Keys.
# Live keys (rzp_live_…) are refused outside the prod profile because they charge real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=paste-your-test-key-secret-here
# Dashboard → Webhooks → your webhook's secret (optional locally; needed in production)
RAZORPAY_WEBHOOK_SECRET=

# Admin panel: comma-separated emails allowed in (they still sign in with their own password)
ADMIN_EMAILS=you@example.com
